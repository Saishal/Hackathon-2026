# Copy to backend/.env; npm start reads it on Node 24. Never commit the real file.
# demo = guaranteed offline. openai/auto require both key and model.
KEYSTONE_AI_PROVIDER=demo
OPENAI_API_KEY=
# Set an account-accessible model that supports Responses structured outputs.
# gpt-4.1-mini is verified working against the grounding checks. gpt-4.1-nano was tested and
# fails them repeatedly (duplicate categories, assignments on not_applicable actions, missing
# knowledge-transfer elements), so it silently serves the demo fallback. Avoid o-series and
# gpt-5 reasoning models: reasoning tokens share the 6000 max_output_tokens budget.
KEYSTONE_AI_MODEL=
KEYSTONE_AI_TIMEOUT_MS=20000

# Security and governance (see docs/ENTERPRISE-GOVERNANCE.md)
# "demo" seeds the four demo accounts into an empty users table. Production never seeds accounts.
KEYSTONE_ENVIRONMENT=demo
# Development-only password for seeded demo accounts. Leave empty to use the default documented in the README.
KEYSTONE_DEMO_PASSWORD=
# Browser origins allowed to call the API with the session cookie, comma-separated.
KEYSTONE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when served over HTTPS. Always on in production.
KEYSTONE_COOKIE_SECURE=false
KEYSTONE_SESSION_IDLE_MINUTES=480
KEYSTONE_SESSION_ABSOLUTE_HOURS=24
# Unselected Keep me signed in: browser-session cookie, capped by this and absolute hours.
KEYSTONE_SESSION_SHORT_HOURS=8
KEYSTONE_LOGIN_MAX_FAILURES=5
KEYSTONE_LOGIN_WINDOW_MINUTES=15
# Pin "today" as YYYY-MM-DD for date-based data-quality rules in demos and tests. Empty uses the real date.
KEYSTONE_TODAY=

# Optional. If set, every unexpected server error (HTTP 5xx) is POSTed here as JSON with
# both `content` (Discord) and `text` (Slack) fields, so either webhook works unchanged.
# Leave empty to disable. /api/health never depends on this.
KEYSTONE_ALERT_WEBHOOK_URL=
