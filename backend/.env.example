# Copy to backend/.env; npm start reads it on Node 24. Never commit the real file.
# demo = guaranteed offline. openai/auto require both key and model.
KEYSTONE_AI_PROVIDER=demo
OPENAI_API_KEY=
# Set an account-accessible model that supports Responses structured outputs.
# gpt-4.1-mini is verified working against the grounding checks. gpt-4.1-nano was tested and
# fails them repeatedly (duplicate categories, assignments on not_applicable actions, missing
# knowledge-transfer elements), so it silently serves the demo fallback. Avoid o-series and
# gpt-5 reasoning models: reasoning tokens share the 6000 max_output_tokens budget.
KEYSTONE_AI_MODEL=
KEYSTONE_AI_TIMEOUT_MS=20000
# Optional. If set, every unexpected server error (HTTP 5xx) is POSTed here as JSON with
# both `content` (Discord) and `text` (Slack) fields, so either webhook works unchanged.
# Leave empty to disable. /api/health never depends on this.
KEYSTONE_ALERT_WEBHOOK_URL=
