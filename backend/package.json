{
  "name": "skillsight-backend",
  "version": "1.0.0",
  "description": "SkillSight API server",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" index.js",
    "start": "node --env-file-if-exists=.env index.js",
    "seed:reset": "node --env-file-if-exists=.env scripts/reset-demo-data.js",
    "seed:enterprise": "node --env-file-if-exists=.env scripts/reset-demo-data.js --dataset enterprise",
    "dataset:enterprise": "node scripts/generate-enterprise-dataset.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "skillsight",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "openai": "^7.15.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
